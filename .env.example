# -------------------------------------------------------------
# Web3Forms (works with static export / plain Hostinger hosting)
# -------------------------------------------------------------
# 1. Go to https://web3forms.com and enter connect@greypromosindia.com
# 2. Verify the email - you'll receive an "Access Key"
# 3. Paste that key below, then rebuild the site (npm run build)
#
# This key is PUBLIC by design (it only acts as an alias to your email),
# so it is safe to ship inside the static site. That's why it uses the
# NEXT_PUBLIC_ prefix, which makes it available in the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key


# -------------------------------------------------------------
# (Legacy) Resend - only used by the /api/* routes, which require a
# Node.js server. Not needed for the static Hostinger + Web3Forms setup.
# -------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=Grey Promos <connect@your-verified-domain.com>
# CONTACT_RECIPIENT_EMAIL=connect@greypromosindia.com
# CAREERS_RECIPIENT_EMAIL=connect@greypromosindia.com
